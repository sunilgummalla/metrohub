# Local scratch space
scratch/*
!scratch/.gitkeep
!scratch/README.md

# JavaScript / pnpm
js/node_modules/
js/**/node_modules/
js/.pnpm-store/
js/**/.next/
js/**/dist/
js/**/coverage/
js/**/tsconfig.tsbuildinfo

# Flutter / Dart / Melos
flutter/.dart_tool/
flutter/**/.dart_tool/
flutter/**/build/
flutter/**/.flutter-plugins
flutter/**/.flutter-plugins-dependencies

# Python / uv
py/.venv/
py/**/__pycache__/
py/**/.pytest_cache/
py/**/.ruff_cache/
py/**/build/
py/**/dist/
