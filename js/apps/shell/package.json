{
  "name": "@metrohub/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3002",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@metrohub/bingo": "workspace:*",
    "@metrohub/housing-loan": "workspace:*",
    "@metrohub/raffle": "workspace:*",
    "@metrohub/poker-scorecard": "workspace:*",
    "@metrohub/rummy-scorecard": "workspace:*",
    "@metrohub/plans": "workspace:*",
    "@metrohub/marketplace": "workspace:*",
    "@metrohub/tambola": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "@vitejs/plugin-react": "4.3.1",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.7",
    "typescript": "5.5.3",
    "vite": "5.3.3"
  }
