# MetroHub secret catalog for the per-env APP stacks (mh-dev, mh-prod).
#   <name>  required|optional  [description]
# Provisioned namespaced as <stack>_<name> via
#   sync-secrets.sh --stack <stack> --file <stack>.secrets.yaml --catalog secrets.catalog
# MetroHub has no datastore; the only secret is the Cloudflare tunnel token.

cloudflare_tunnel_token   required   Cloudflare Tunnel token for THIS env's tunnel
