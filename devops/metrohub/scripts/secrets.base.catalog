# MetroHub secret catalog for the SHARED base stack (metrohub-base): one MongoDB for
# the whole VPS. Provisioned namespaced as metrohub-base_<name> via
#   sync-secrets.sh --stack metrohub-base --file metrohub-base.secrets.yaml --catalog scripts/secrets.base.catalog
# Root is first-init only; one app user per env is created on first init with
# readWrite on that env's db (the app connects as it via the env's mongo_uri).

mongo_root_username   required   Mongo root username (first-init only)
mongo_root_password   required   Mongo root password (first-init only)
app_dev_username      required   app user for metrohub_dev (readWrite)
app_dev_password      required   password for app_dev_username
app_prod_username     required   app user for metrohub_prod (readWrite)
app_prod_password     required   password for app_prod_username
